# Copy to .env.local and fill in. Never commit real values.

# Supabase (Phase 1+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/fetch (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Polite User-Agent contact for feed fetching
FEEDWISE_CONTACT_URL=https://github.com/matttmade/feedwise
