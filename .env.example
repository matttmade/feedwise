# Copy to .env.local for local work (pnpm db:start prints the local Supabase keys).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only these emails can sign in (comma-separated). v1 is single-user.
ALLOWED_EMAILS=

# Protects /api/cron/fetch. The GitHub Actions schedule sends it as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Signs image-proxy URLs for images inside articles. Generate with: openssl rand -hex 32
IMAGE_PROXY_SECRET=

# Your time zone, so "today" starts at your midnight (IANA name, e.g. Europe/London).
APP_TIMEZONE=UTC

# Public site URL, used as the magic-link fallback origin (e.g. https://feedwise.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Contact URL in the feed fetcher's User-Agent
FEEDWISE_CONTACT_URL=https://github.com/matttmade/feedwise
