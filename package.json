{
  "name": "feedwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx scripts/spike.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:types": "supabase gen types typescript --local 2>/dev/null > lib/supabase/database.types.ts",
    "db:reset": "supabase db reset",
    "audit:a11y": "tsx scripts/audit.ts",
    "audit:lighthouse": "tsx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "feedsmith": "^3.0.1",
    "jsdom": "^26.1.0",
    "next": "16.4.2",
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/turbopack": "^4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
